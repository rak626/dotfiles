{
    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "modules-left": [],
    "modules-center": [
        "clock",
        "hyprland/workspaces",
        "pulseaudio",
        "network",
        "battery"
    ],
    "modules-right": [],
    "battery": {
        "format": "{capacity}",
        "interval": 60
    },
    "clock": {
        "interval": 60,
        "format": "{:%H:%M}",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },
    "pulseaudio": {
        "format": "{volume}% <span size='130%'>󰕾</span>",
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "{essid} <span size='130%'>󰤨</span>",
        "format-ethernet": "Wired <span size='130%'>󰈀</span>",
        "format-disconnected": "Disconnected <span size='130%'>󰤮</span>",
        "tooltip": false
    }
}