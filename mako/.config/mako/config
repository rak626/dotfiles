# ===== GENERAL =====
font=IosevkaRakesh Nerd Font 11
background-color=#232136f2
text-color=#e0def4
border-color=#c4a7e7
border-size=2
border-radius=8

width=350
margin=15
padding=15
anchor=top-right
default-timeout=5000
layer=overlay

# ===== PROGRESS BARS =====
progress-color=#3e8fb0

# ===== BEHAVIOR =====
sort=-time
max-visible=5
max-history=10

# ===== ICONS =====
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark

# ===== URGENCY =====
[urgency=low]
border-color=#6e6a86
background-color=#232136d9
default-timeout=3000

[urgency=normal]
border-color=#c4a7e7
background-color=#232136f2

[urgency=critical]
border-color=#eb6f92
background-color=#232136
default-timeout=15000

# ===== TEXT =====
markup=1
format=<span size="large" weight="bold" foreground="#c4a7e7">%s</span>\n%b

# ===== APP SPECIFIC =====
[app-name=Spotify]
border-color=#1db954
default-timeout=8000
