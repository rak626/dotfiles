* {
    bg:         #282c34;
    bg-alt:     #3e4452;
    fg:         #abb2bf;

    border:     #3e4452;

    selected:   #61afef;
    active:     #98c379;
    urgent:     #e06c75;

    background-color: @bg;
    text-color: @fg;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;

    width: 600px;

    border: 2px;
    border-color: @border;

    border-radius: 14px;

    background-color: @bg;
}

mainbox {
    children: [inputbar, listview];
    spacing: 12px;
    padding: 16px;
    background-color: @bg;
}

inputbar {
    children: [prompt, entry];
    spacing: 10px;

    padding: 12px;

    border: 2px;
    border-radius: 10px;
    border-color: @border;

    background-color: @bg-alt;
}

prompt {
    text-color: @active;
}

entry {
    placeholder: "Search...";
    placeholder-color: #5c6370;
}

listview {
    lines: 10;
    columns: 1;

    fixed-height: false;

    spacing: 6px;
    scrollbar: false;

    background-color: transparent;
}

element {
    padding: 10px;
    border-radius: 10px;

    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @border;
    text-color: @selected;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 24px;
    background-color: inherit;
    margin: 0 10px 0 0;
}
