# UWSM Environment Variables
# This file is sourced by UWSM before starting the compositor.
# It is the "correct" place for all toolkit and system-wide variables on Arch.

# --- XDG Specifications ---
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland

# --- Toolkit Backends ---
export GDK_BACKEND=wayland,x11,*
export QT_QPA_PLATFORM=wayland;xcb
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland

# --- Qt Variables ---
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=Fusion

# --- Nvidia Specifics (Comment out if using AMD/Intel) ---
# If you are on Arch, you likely have the 'nvidia' or 'nvidia-open' package.
export GBM_BACKEND=nvidia-drm
export LIBVA_DRIVER_NAME=nvidia
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export NVD_BACKEND=direct

# --- Hardware Acceleration / Electron ---
export ELECTRON_OZONE_PLATFORM_HINT=auto

# --- Gtk Theme ---
# Standardizing on Dark Adwaita for now, consistent with your One Dark/Rosé Pine vibes
export GTK_THEME=Adwaita:dark
export GTK_APPLICATION_PREFER_DARK_THEME=1

# --- Curors ---
export XCURSOR_SIZE=24
export HYPRCURSOR_SIZE=24
