{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " → ",
    "color": {
      "keys": "green",
      "title": "green"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󰣇 OS        ",
      "keyColor": "green",
      "format": "{name} {version-id} ({arch})"
    },
    {
      "type": "host",
      "key": " Host      ",
      "keyColor": "green"
    },
    {
      "type": "bios",
      "key": " BIOS      ",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": " Kernel    ",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": " CPU       ",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": " GPU       ",
      "keyColor": "green",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": " Memory    ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk      ",
      "keyColor": "green",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": " Battery   ",
      "keyColor": "green"
    },
    "separator",
    {
      "type": "display",
      "key": "󱄄 Display   ",
      "keyColor": "blue"
    },
    {
      "type": "brightness",
      "key": "󰃠 Brightness",
      "keyColor": "blue"
    },
    {
      "type": "sound",
      "key": " Sound     ",
      "keyColor": "blue"
    },
    {
      "type": "bluetooth",
      "key": "󰂯 Bluetooth ",
      "keyColor": "blue"
    },
    {
      "type": "wifi",
      "key": " Wi-Fi     ",
      "keyColor": "blue"
    },
    {
      "type": "locale",
      "key": " Locale    ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": " WM        ",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": " DE        ",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "󰉼 WM Theme  ",
      "keyColor": "blue"
    },
    {
      "type": "theme",
      "key": " GTK Theme ",
      "keyColor": "blue"
    },
    {
      "type": "icons",
      "key": "󰀻 Icons     ",
      "keyColor": "blue"
    },
    {
      "type": "cursor",
      "key": "➶ Cursor    ",
      "keyColor": "blue"
    },
    "separator",
    {
      "type": "terminal",
      "key": " Terminal  ",
      "keyColor": "magenta"
    },
    {
      "type": "terminalfont",
      "key": " Term Font ",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "󱆃 Shell     ",
      "keyColor": "magenta"
    },
    {
      "type": "editor",
      "key": " Editor    ",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages  ",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime    ",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "󰲉 OS Age    ",
      "keyColor": "magenta",
      "text": "b=$(stat -c %W /); [ \"$b\" -eq 0 ] && b=$(stat -c %W /etc/machine-id); echo \"$(( ($(date +%s) - b) / 86400 )) days ($(date -d @$b +%F))\""
    },
    {
      "type": "datetime",
      "key": "󰃰 Date      ",
      "keyColor": "magenta",
      "format": "{weekday}, {day-pretty}-{month-pretty}-{year} {hour-pretty}:{minute-pretty}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1,
      "brightness": "normal"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1,
      "brightness": "light"
    }
  ]
}
